#      Common .gitignore Configuration      #
#############################################
#                                           #
# Based on the gist provided by             #
# GitHub at:                                #
# https://gist.github.com/octocat/9257657   #
#                                           #
# and also modified by                      #
# MrKoby07                                  #
# for personal use                          #
# Homepage: https://master3307.org/         #
#############################################


# Custom #
##########
/config.json
.node-version


# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so


# Packages #
############
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
*.tgz


# Output Folders #
##################
bin/
obj/
out/
build/
dist/
dist-ssr/


# Logs and databases #
######################
logs
*.log
*.sql
*.sqlite
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*


# Diagnostic reports #
######################
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json


# Runtime data #
################
pids
*.pid
*.seed
*.pid.lock


# Coverage #
############
coverage
*.lcov
.nyc_output


# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


# Backup or temporary files #
#############################
*.pyo
*.pyc
*~
*.bak


# Code editors #
################
.vscode/
*.code-workspace
.idea/
*.sublime-workspace
*.sublime-project
*.swo
*.swx
*.swp
.session
\#*\#


# Python tooling #
##################
.venv/
venv/
.env
.env.*
.env.test


# Node / JS tooling #
#####################
node_modules/
jspm_packages/
bower_components
package-lock.json
.lock-wscript
.npm
.eslintcache
.node_repl_history
.yarn-integrity
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.grunt
lib-cov
.oxlint


# TypeScript #
##############
typings/
*.tsbuildinfo


# Framework builds #
####################
.next
.nuxt
.vuepress/dist
.cache/
.serverless/
.fusebox/
.dynamodb/


# Misc #
########
*.local
.tern-port


# Obsidian #
############
*.obsidian/


# MkDocs #
##########
/site


# Server #
##########
update.sh
server/*.csv
server/*.json
