# =============================================================================
# Discord bot
# =============================================================================

# Bot token from Discord Developer Portal -> Bot -> Token.
# Secret: never commit the real value.
DISCORD_BOT_TOKEN=your_discord_bot_token

# Your Discord user ID. Used by the presence/profile service.
DISCORD_USER_ID=817826076486139985

# Discord server (guild) ID used by the bot and presence service.
DISCORD_GUILD_ID=1479192792386375852

# Debounce time for emoji sync in milliseconds.
EMOJI_SYNC_DEBOUNCE_MS=10000

# Comma-separated Discord user IDs allowed to use owner-only bot commands.
BOT_OWNERS=817826076486139985,1233908962550616085

# Prefix for legacy/message-based bot commands.
BOT_PREFIX=c!


# =============================================================================
# Discord OAuth account login
# =============================================================================

# Discord Application ID / OAuth2 client ID.
DISCORD_CLIENT_ID=1525217425987993752

# Discord Developer Portal -> OAuth2 -> Client Secret.
# Secret: never commit the real value.
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Must exactly match an entry in:
# Discord Developer Portal -> OAuth2 -> Redirects
#
# Production:
DISCORD_REDIRECT_URI=https://discord-api.master3307.org/auth/discord/callback

# The public frontend URL to redirect to after a successful login.
FRONTEND_ORIGIN=https://home.master3307.org

# Public base URL for the account API.
# Used when the API returns locally cached avatar URLs.
API_ORIGIN=https://discord-api.master3307.org

# Long random secret used only by the short-lived OAuth state session.
# Generate with: openssl rand -base64 48
# Secret: never commit the real value.
SESSION_SECRET=replace_with_a_long_random_secret

# Persistent account login duration in days.
SESSION_TTL_DAYS=30

# Internal-only port for server/account-api.cjs.
# Nginx/Caddy should proxy public /auth/* and /avatars/* requests here.
ACCOUNT_API_PORT=3002


# =============================================================================
# Existing Discord profile / presence API
# =============================================================================

# Internal-only port for server/services/discord-profile.js.
# Keep this unchanged if your existing reverse-proxy config uses port 3001.
PORT=3001

# Minimum 15000. Polling interval for Discord presence/activity updates.
ACTIVITY_POLL_INTERVAL_MS=30000


# =============================================================================
# Third-party game and music integrations
# =============================================================================

# RAWG game database API key.
# Leave as placeholder if that feature is not configured.
RAWG_API_KEY=your_rawg_api_key

# IGDB/Twitch API credentials.
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# SteamGridDB API key.
STEAMGRIDDB_API_KEY=your_steamgriddb_api_key

# Spotify Client Credentials flow credentials.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
