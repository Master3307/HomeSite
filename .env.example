# =============================================================================
# Instructions
# =============================================================================

# Copy this file to .env and fill in your own values.
# Enjoy using HomeSite! :D



# =============================================================================
# Discord bot
# =============================================================================

# Bot token from Discord Developer Portal -> Bot -> Token.
# Secret: never commit the real value.
DISCORD_BOT_TOKEN=your_discord_bot_token

# Your Discord user ID. Used by the presence/profile service.
DISCORD_USER_ID=817826076486139985

# Discord server (guild) ID used by the bot and presence service.
DISCORD_GUILD_ID=1479192792386375852

# Debounce time for emoji sync in milliseconds.
EMOJI_SYNC_DEBOUNCE_MS=10000

# Comma-separated Discord user IDs allowed to use owner-only bot commands.
BOT_OWNERS=817826076486139985,1233908962550616085

# Prefix for legacy/message-based bot commands.
BOT_PREFIX=c!


# =============================================================================
# Discord OAuth account login
# =============================================================================

# Discord Application ID / OAuth2 client ID.
DISCORD_CLIENT_ID=1525217425987993752

# Discord Developer Portal -> OAuth2 -> Client Secret.
# Secret: never commit the real value.
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Must exactly match an entry in:
# Discord Developer Portal -> OAuth2 -> Redirects
#
# Production:
DISCORD_REDIRECT_URI=https://discord-api.master3307.org/auth/discord/callback

# The public frontend origin URL. Used for CORS and other security checks.
FRONTEND_ORIGIN=https://home.master3307.org

# The public frontend redirect URL to redirect to after a successful login.
FRONTEND_REDIRECT_URL=https://home.master3307.org/cult

# Public base URL for the account API.
# Used when the API returns locally cached avatar URLs.
API_ORIGIN=https://discord-api.master3307.org

# Long random secret used only by the short-lived OAuth state session.
# Generate with: openssl rand -base64 48
# Secret: never commit the real value.
SESSION_SECRET=replace_with_a_long_random_secret

# Persistent account login duration in days.
SESSION_TTL_DAYS=30

# Internal-only port for server/account-api.cjs.
# Nginx/Caddy should proxy the public account API host here, including
# /auth/*, /account/*, /avatars/*, /fdc/* and /discord/* (widget, lobby).
ACCOUNT_API_PORT=3002

# Admin code for the "Use an admin code" login. Logs in as the bot's own
# Discord identity ("Cultbot", owner role) without Discord OAuth, e.g. to
# create FDC polls from the website. At least 16 characters; leave empty to
# disable admin login. Generate with: openssl rand -base64 32
# Secret: never commit the real value.
ADMIN_KEY=

# How long an admin-code session lasts, in hours.
ADMIN_SESSION_TTL_HOURS=12

# --- Running the site locally or on a local server ---------------------------
# `pnpm dev` and `pnpm preview` serve the account API on the site's own
# origin under /account-api (scripts/account-api-proxy.mjs), so admin-code
# logins stick on localhost / LAN addresses and FDC polls can be uploaded.
# Run `pnpm accounts` and `pnpm bot` locally to post through your own bot;
# without them the proxy falls back to the production API.
#
# Targets the proxy tries in order (first healthy one wins).
# Default: http://127.0.0.1:$ACCOUNT_API_PORT,https://accounts-api.master3307.org
ACCOUNT_API_PROXY_TARGETS=
#
# Account API URL baked into the frontend build. Empty = production API
# (dev always uses /account-api). Set to /account-api when you build the
# site to serve it with `pnpm preview` on a local server.
VITE_ACCOUNT_API_URL=


# =============================================================================
# Bot internal API (website FDC votes/polls, Discord widget)
# =============================================================================

# Local-only address of the bot's internal API (server/services/internalApi.cjs).
# The account API forwards website votes and new FDC polls here.
BOT_INTERNAL_URL=http://127.0.0.1:3004

# Shared secret between the account API and the bot's internal API.
# Optional: when empty, a key derived from DISCORD_BOT_TOKEN is used.
# Secret: never commit the real value.
INTERNAL_API_KEY=

# Invite code shown by the website's Discord widget.
DISCORD_INVITE_CODE=3vCGMRapHT


# =============================================================================
# Existing Discord profile / presence API
# =============================================================================

# Internal-only port for server/services/discord-profile.js.
# Keep this unchanged if your existing reverse-proxy config uses port 3001.
PORT=3001

# Minimum 15000. Polling interval for Discord presence/activity updates.
ACTIVITY_POLL_INTERVAL_MS=30000


# =============================================================================
# Third-party game and music integrations
# =============================================================================

# RAWG game database API key.
# Leave as placeholder if that feature is not configured.
RAWG_API_KEY=your_rawg_api_key

# IGDB/Twitch API credentials.
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# SteamGridDB API key.
STEAMGRIDDB_API_KEY=your_steamgriddb_api_key

# Spotify Client Credentials flow credentials.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret



# =============================================================================
# Maps (/maps) – OpenStreetMap login
# =============================================================================

# OAuth 2 client ID of a *public* OSM application (no client secret needed,
# the site uses PKCE). Register one at
# https://www.openstreetmap.org/oauth2/applications/new with:
#   Redirect URIs: https://home.master3307.org/maps
#                  http://localhost:5173/maps
#   Confidential application: unchecked
#   Permissions: Read user preferences, Modify the map, Modify notes
# Leave empty to disable OSM login (notes still work anonymously).
VITE_OSM_CLIENT_ID=

# Same for the OSM test server (https://master.apis.dev.openstreetmap.org),
# used when "Test server" is selected in the map settings.
VITE_OSM_DEV_CLIENT_ID=


# =============================================================================
# Maps (/maps) – photos
# =============================================================================

# Mapillary *client token* (public, read-only) for street-level photos.
# Create an app at https://www.mapillary.com/dashboard/developers and copy the
# "Client Token" (starts with MLY|). Never put the client secret here.
VITE_MAPILLARY_CLIENT_TOKEN=

# OAuth 2.0 client ID of a *non-confidential* Wikimedia consumer, used to
# upload place photos to Wikimedia Commons. Propose one at
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
#   Client is confidential: unchecked
#   Callback URL: https://home.master3307.org/maps
#   Grants: Basic rights, Upload new files
# Until Wikimedia approves it, only your own account can log in with it.
VITE_WIKIMEDIA_CLIENT_ID=
