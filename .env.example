# =============================================================================
# HomeSite settings
# =============================================================================
#
# Easiest: run `pnpm setup:gui` (or `pnpm setup:cli` in a terminal). It walks
# you through everything, with guides, and writes .env for you. Once the site
# runs, the admin account can change all of this on /admin-settings.
#
# By hand: copy this file to .env and fill in what you need. Empty values use
# the default or switch that feature off; nothing has to be changed in code.
#
# Generated from config/settings.cjs by `pnpm env:example`; edit that file,
# not this one.

# =============================================================================
# Website
# =============================================================================
# Where the site and its APIs live.

# Website address (required, public, part of the website build)
# The public address of the website, without a trailing slash. Used for CORS,
# cookies, the sitemap and links.
#   Example: https://example.com
FRONTEND_ORIGIN=http://localhost:5173

# Page after login (feature: Website login with Discord)
# Where people land after logging in with Discord. Empty: the website address.
#   Example: https://example.com/cult
FRONTEND_REDIRECT_URL=

# Account API address (important, feature: Website login with Discord, public, part of the website build)
# Public address of the account API (server/account-api.cjs). Your reverse
# proxy (Nginx, Caddy, Cloudflare Tunnel …) forwards it to ACCOUNT_API_PORT.
# Empty: the website uses /account-api on its own address.
#   Example: https://accounts-api.example.com
ACCOUNT_API_ORIGIN=

# Profile API address (important, feature: Discord profile card, public, part of the website build)
# Public address of the Discord profile/presence API
# (server/services/discord-profile.js, PORT). The home page loads your live
# Discord card from here.
#   Example: https://discord-api.example.com
PROFILE_API_ORIGIN=

# Login cookie domain (recommended, feature: Website login with Discord)
# Shares the login cookie between the site and its API subdomains, e.g.
# example.com when the site is example.com and the API
# accounts-api.example.com. Empty: the cookie only works on the API's own
# host.
#   Example: example.com
AUTH_COOKIE_DOMAIN=

# Source code link (public, part of the website build)
# Link for "View source on GitHub" at the bottom of the cult page. Empty hides
# it.
#   Example: https://github.com/you/HomeSite
SOURCE_REPO_URL=

# Own search engine (public, part of the website build)
# An extra search engine for the dashboard (e.g. your own SearXNG). Use %s
# where the search text goes. Empty hides it.
#   Example: https://search.example.com/search?q=%s
SEARCH_ENGINE_URL=

# Own search engine name (public, part of the website build)
# Name shown for that search engine.
SEARCH_ENGINE_NAME=My search

# =============================================================================
# Discord app & bot
# =============================================================================
# The Discord application that powers the bot and the login.

# Application ID (required, public, part of the website build)
# Discord Developer Portal → your application → General Information →
# Application ID. The bot's user ID is the same number.
#   Discord Developer Portal: https://discord.com/developers/applications
#   Discord: getting started with apps: https://discord.com/developers/docs/quick-start/getting-started
DISCORD_CLIENT_ID=

# Client secret (important, feature: Website login with Discord, needed for that feature)
# Developer Portal → OAuth2 → Client Secret (Reset Secret to see it). Needed
# for the website login.
#   Discord Developer Portal: https://discord.com/developers/applications
#   Secret: never commit the real value.
DISCORD_CLIENT_SECRET=

# Bot token (required)
# Developer Portal → Bot → Reset Token. Also turn on the Server Members and
# Message Content intents there, and invite the bot to your server (OAuth2 →
# URL Generator → bot + applications.commands).
#   Discord Developer Portal: https://discord.com/developers/applications
#   Discord: bot users & tokens: https://discord.com/developers/docs/topics/oauth2#bot-users
#   Secret: never commit the real value.
DISCORD_BOT_TOKEN=

# OAuth redirect (feature: Website login with Discord)
# Must match an entry under Developer Portal → OAuth2 → Redirects exactly. The
# account API answers on /auth/discord/callback. Empty: <Account API
# address>/auth/discord/callback.
#   Discord Developer Portal: https://discord.com/developers/applications
#   Example: https://accounts-api.example.com/auth/discord/callback
DISCORD_REDIRECT_URI=

# Server ID (required, public, part of the website build)
# Your Discord server. Right-click the server icon → Copy Server ID (needs
# Developer Mode).
#   How to copy IDs in Discord (Developer Mode): https://support.discord.com/hc/en-us/articles/206346498-Where-can-I-find-my-User-Server-Message-ID
DISCORD_GUILD_ID=

# Invite code (recommended, public, part of the website build)
# The part after discord.gg/ of a permanent invite to your server, used by the
# widget and the Join buttons.
#   Discord: invites 101: https://support.discord.com/hc/en-us/articles/208866998-Invites-101
#   Example: abcDEF123
DISCORD_INVITE_CODE=

# Command prefix
# Prefix for the old text commands (slash commands always work).
BOT_PREFIX=!

# Admin account name (public, part of the website build)
# Name of the admin account on the website (the admin-code login acts as the
# bot). Usually your bot's name.
BOT_DISPLAY_NAME=Admin

# =============================================================================
# People & roles
# =============================================================================
# Who owns the site and which Discord roles have extra rights.

# Your Discord user ID (recommended, public, part of the website build)
# You, the site owner. The profile card shows this person; right-click
# yourself → Copy User ID.
#   How to copy IDs in Discord (Developer Mode): https://support.discord.com/hc/en-us/articles/206346498-Where-can-I-find-my-User-Server-Message-ID
DISCORD_USER_ID=

# Bot owners (important)
# User IDs that may use owner-only bot commands, separated by commas.
#   How to copy IDs in Discord (Developer Mode): https://support.discord.com/hc/en-us/articles/206346498-Where-can-I-find-my-User-Server-Message-ID
BOT_OWNERS=

# Community leader (public, part of the website build)
# A second special person (e.g. the server's leader): can always post lobby
# codes, and gets their own lobby-cat greetings. Optional.
#   How to copy IDs in Discord (Developer Mode): https://support.discord.com/hc/en-us/articles/206346498-Where-can-I-find-my-User-Server-Message-ID
COMMUNITY_LEADER_ID=

# Moderator role (recommended)
# Role that may use moderation commands (ban, kick …) and manage FDC polls.
# Right-click the role → Copy Role ID.
#   How to copy IDs in Discord (Developer Mode): https://support.discord.com/hc/en-us/articles/206346498-Where-can-I-find-my-User-Server-Message-ID
MOD_ROLE_ID=

# =============================================================================
# Bot features
# =============================================================================
# Optional bot features. Leave a feature empty to switch it off.

# Role for new members (feature: Role on join)
# Given to everyone who joins. Empty: off. The bot's role must be above it.
JOIN_ROLE_ID=

# Lobby code channel (feature: Lobby codes, needed for that feature)
# Channel where /lobby-code posts codes. Empty: lobby codes are off.
LOBBY_CHANNEL_ID=

# Lobby ping role (feature: Lobby codes)
# Role pinged for new lobby codes. Empty: no ping.
LOBBY_PING_ROLE_ID=

# Lobby review channel (feature: Lobby codes)
# Codes from members without a trusted role wait here for approval. Empty:
# everyone posts directly.
LOBBY_REVIEW_CHANNEL_ID=

# Lobby reviewer role (feature: Lobby codes, needed for that feature)
# Role pinged in the review channel.
LOBBY_REVIEW_ROLE_ID=

# Trusted roles (feature: Lobby codes)
# Roles whose lobby codes skip the review, separated by commas.
LOBBY_TRUSTED_ROLE_IDS=

# FDC channel (feature: FDC polls, needed for that feature)
# Default channel for FDC polls. Empty: polls need a channel picked in /fdc.
FDC_CHANNEL_ID=

# FDC role (feature: FDC polls)
# Role that may create FDC polls and is pinged for new ones (moderators always
# may).
FDC_ROLE_ID=

# Sticky message channel (feature: Sticky message, needed for that feature)
# The bot keeps its info message at the bottom of this channel. Empty: off.
STICKY_CHANNEL_ID=

# Sticky message text (feature: Sticky message, needed for that feature)
# The text the bot keeps at the bottom of the sticky channel. Discord markdown
# works; write \n for a new line.
STICKY_MESSAGE=

# Level-up channel (feature: Levels & XP)
# Where level-up messages go. Empty: they are not posted (XP still counts).
LEVEL_UP_CHANNEL_ID=

# Level roles (feature: Levels & XP)
# Role IDs for level 1, 2, 3 … in order, separated by commas (up to 13).
# Missing ones are skipped.
LEVEL_ROLE_IDS=

# Birthday channel (feature: Birthdays, needed for that feature)
# Where birthday wishes are posted. Empty: off.
BIRTHDAY_CHANNEL_ID=

# Minecraft server (feature: Minecraft server status, needed for that feature)
# Address of the Minecraft (Java) server to show. Empty: off.
#   Example: play.example.com
MINECRAFT_HOST=

# Minecraft port (feature: Minecraft server status)
# Usually 25565.
MINECRAFT_PORT=25565

# Minecraft status thread (feature: Minecraft server status, needed for that feature)
# Thread or channel where the live status message lives.
MINECRAFT_STATUS_THREAD_ID=

# =============================================================================
# Integrations
# =============================================================================
# Third-party services for game art, music, maps and deploys.

# RAWG API key (feature: Game artwork)
# Game details and covers. Free key at rawg.io.
#   RAWG API docs: https://rawg.io/apidocs
#   Secret: never commit the real value.
RAWG_API_KEY=

# IGDB / Twitch client ID (feature: Game artwork, needed for that feature)
# IGDB uses a Twitch developer application.
#   IGDB: getting started: https://api-docs.igdb.com/#getting-started
#   Twitch developer console: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=

# IGDB / Twitch client secret (feature: Game artwork, needed for that feature)
# From the same Twitch application.
#   Secret: never commit the real value.
IGDB_CLIENT_SECRET=

# SteamGridDB API key (feature: Game artwork)
# Nicer game artwork.
#   SteamGridDB API key: https://www.steamgriddb.com/profile/preferences/api
#   Secret: never commit the real value.
STEAMGRIDDB_API_KEY=

# Spotify client ID (feature: Spotify details, needed for that feature)
# Create an app in the Spotify developer dashboard (any redirect URI).
#   Spotify developer dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=

# Spotify client secret (feature: Spotify details, needed for that feature)
# From the same Spotify app.
#   Secret: never commit the real value.
SPOTIFY_CLIENT_SECRET=

# OpenStreetMap client ID (feature: Maps login & photos)
# OAuth 2 client ID of a public OSM application (no secret, the site uses
# PKCE). Redirect URIs: <your site>/maps and http://localhost:5173/maps;
# confidential: unchecked; permissions: read preferences, modify the map,
# modify notes. Empty: OSM login off.
#   Register an OSM application: https://www.openstreetmap.org/oauth2/applications/new
VITE_OSM_CLIENT_ID=

# OSM test server client ID (feature: Maps login & photos)
# Same for the OSM test server, used when "Test server" is picked in the map
# settings.
#   OSM test server: https://master.apis.dev.openstreetmap.org/oauth2/applications/new
VITE_OSM_DEV_CLIENT_ID=

# Mapillary client token (feature: Maps login & photos)
# Public, read-only client token (starts with MLY|) for street-level photos.
# Never the client secret.
#   Mapillary developer dashboard: https://www.mapillary.com/dashboard/developers
VITE_MAPILLARY_CLIENT_TOKEN=

# Wikimedia client ID (feature: Maps login & photos)
# OAuth 2.0 client ID of a non-confidential Wikimedia consumer for photo
# uploads to Commons. Callback: <your site>/maps; grants: basic rights, upload
# new files. Until approved only your own account can use it.
#   Propose a Wikimedia consumer: https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
VITE_WIKIMEDIA_CLIENT_ID=

# GitHub webhook secret (feature: Auto deploy from GitHub)
# Secret of the GitHub push webhook that triggers scripts/deploy.sh
# (server/services/github-deploy-listener.mjs).
#   GitHub: creating webhooks: https://docs.github.com/en/webhooks/using-webhooks/creating-webhooks
#   `pnpm setup:cli` can generate it for you.
#   Secret: never commit the real value.
GITHUB_WEBHOOK_SECRET=

# =============================================================================
# Security
# =============================================================================
# Secrets, sessions, the admin login and two-factor codes.

# Session secret (important, feature: Website login with Discord)
# Long random secret for the short OAuth state session. Generate one, nobody
# needs to remember it.
#   `pnpm setup:cli` can generate it for you.
#   Secret: never commit the real value.
SESSION_SECRET=

# Stay logged in (days) (feature: Website login with Discord)
# How long a website login lasts.
SESSION_TTL_DAYS=30

# Admin key (important)
# Password for "Use an admin code" on the login: logs in as the bot with the
# owner role (FDC polls, backups, these settings). At least 16 characters;
# empty disables admin login. Keep it somewhere safe.
#   `pnpm setup:cli` can generate it for you.
#   Secret: never commit the real value.
ADMIN_KEY=

# Admin login (hours)
# How long an admin-code login lasts.
ADMIN_SESSION_TTL_HOURS=12

# Two-factor codes (recommended, feature: Two-factor codes for the admin)
# When on, the admin login and critical actions (opening admin settings,
# backups, .env changes) need a 6-digit code from an authenticator app. Run
# `pnpm 2fa:setup` and `pnpm 2fa:verify` first.
#   Aegis (Android): https://getaegis.app/
#   2FAS (iOS/Android): https://2fas.com/
ADMIN_2FA=off

# Two-factor secret (important, feature: Two-factor codes for the admin, needed for that feature)
# Written by `pnpm 2fa:setup` (show it again with `pnpm 2fa:qr`). Needs access
# to the server on purpose.
#   Secret: never commit the real value.
ADMIN_2FA_SECRET=

# Internal API key
# Shared secret between the account API and the bot. Empty: derived from the
# bot token, which works fine.
#   `pnpm setup:cli` can generate it for you.
#   Secret: never commit the real value.
INTERNAL_API_KEY=

# Hub key (recommended, feature: Admin hub)
# Private key for /hub and for looking up Discord users on the profile API
# (/<user id>, /<user id>-ui, /history). With 2FA on, the hub also asks for a
# code. Scripts can send it as the X-Hub-Key header. At least 24 characters;
# empty locks the hub and those lookups completely. Not the admin key.
#   `pnpm setup:cli` can generate it for you.
#   Secret: never commit the real value.
HUB_KEY=

# Hub login (hours) (feature: Admin hub)
# How long a hub login lasts before the key (and 2FA code) is needed again.
HUB_SESSION_TTL_HOURS=12

# Server terminal in the hub (feature: Admin hub)
# A full shell on the server inside /hub (runs as the user of the account
# API). Only turn it on if you need it; anyone with the hub key (and 2FA code)
# gets shell access.
HUB_TERMINAL=off

# =============================================================================
# Advanced
# =============================================================================
# Ports, internal addresses and timings. The defaults are usually fine.

# Emoji sync delay (ms)
# How long the bot waits after emoji changes before syncing them.
EMOJI_SYNC_DEBOUNCE_MS=10000

# Terminal shell (feature: Admin hub)
# Shell for the hub terminal. Empty: $SHELL, else /bin/bash.
#   Example: /usr/bin/fish
HUB_TERMINAL_SHELL=

# Account API port (recommended, feature: Website login with Discord)
# Local port of server/account-api.cjs. Your reverse proxy forwards
# ACCOUNT_API_ORIGIN here (including /auth, /account, /avatars, /fdc,
# /discord).
ACCOUNT_API_PORT=3002

# Profile API port (recommended, feature: Discord profile card)
# Local port of the Discord profile API (pnpm discord). Also the /api target
# of `pnpm dev`.
PORT=3001

# Bot internal API
# Local address of the bot's internal API; the account API forwards website
# votes and polls here.
BOT_INTERNAL_URL=http://127.0.0.1:3004

# Dev proxy targets
# `pnpm dev` / `pnpm preview` serve the account API under /account-api.
# Targets tried in order, separated by commas. Empty: the local API, then
# ACCOUNT_API_ORIGIN.
ACCOUNT_API_PROXY_TARGETS=

# Account API URL in the build
# Overrides ACCOUNT_API_ORIGIN for the website build. Set to /account-api to
# serve a build with `pnpm preview` on a local server.
VITE_ACCOUNT_API_URL=

# Presence poll interval (ms) (feature: Discord profile card)
# How often the profile API refreshes Discord activity. At least 15000.
ACTIVITY_POLL_INTERVAL_MS=30000
