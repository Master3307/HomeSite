{
  "name": "home-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "git-sync": "node scripts/sync.cjs",
    "bot": "node server/bot.cjs",
    "discord": "node server/services/discord-profile.js",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "pnpm run sitemap && vite build && cp dist/index.html dist/404.html",
    "lint": "oxlint",
    "preview": "vite preview",
