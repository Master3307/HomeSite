    "@mongez/sitemap": "^1.0.2",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "discord-api-types": "^0.36.2",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-powerglitch": "^1.1.0",
    "react-router": "^8.3.0",
    "use-scramble": "^2.2.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
