{
  "name": "home-site",
  "private": true,
  "type": "module",
  "scripts": {
    "checks": "node scripts/checks.cjs",
    "dev": "pnpm run search:index && vite",
    "git-sync": "node scripts/sync.cjs",
    "fonts:update": "node scripts/update-fonts.mjs",
    "bot": "node server/bot.cjs",
    "fdc:import": "node scripts/import-fdc.cjs",
    "fdc:export": "node scripts/export-fdc.cjs",
    "backup:import": "node scripts/import-backup.cjs",
    "discord": "node server/services/discord-profile.js",
    "accounts": "node server/account-api.cjs",
    "cleaner": "node scripts/clean.cjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "search:index": "node scripts/generate-search-index.mjs",
    "build": "pnpm run sitemap && pnpm run search:index && vite build && node scripts/export-fdc.cjs --dist && node scripts/create-404.cjs && node scripts/app-links.cjs",
    "preview": "vite preview",
    "images": "node scripts/generate-images.mjs",
    "serve": "serve dist -l tcp://127.0.0.1:8081",
    "deploy:local": "bash scripts/deploy.sh",
    "emoji:data": "node scripts/generate-emoji-data.mjs",
    "elements": "node scripts/elements.mjs",
    "translate": "libretranslate --host 127.0.0.1 --port 5000 --load-only en,de,fr,es,it,nl,pl,pt,ru,tr,uk,ja,zh,ko,ar,sv,da,fi,cs,hu,el,ro",
    "fdc:rebadge": "node scripts/fdc-rebadge.cjs",
    "2fa:setup": "node scripts/twofa.cjs setup",
    "2fa:verify": "node scripts/twofa.cjs verify",
    "2fa:qr": "node scripts/twofa.cjs qr",
    "2fa:key": "node scripts/twofa.cjs key",
    "setup:gui": "node scripts/setup/gui.cjs",
    "setup:cli": "node scripts/setup/cli.cjs",
    "env:example": "node scripts/env-example.cjs",
    "bongo:import": "node scripts/bongo-import.cjs",
    "mail:test": "node scripts/mail-test.cjs",
    "push:setup": "node scripts/push-setup.cjs",
    "app:build": "node scripts/app-build.mjs"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@discordjs/rest": "^2.6.3",
    "@mongez/sitemap": "^1.0.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@twemoji/api": "^17.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.2.0",
    "canvas": "^3.2.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "craftping": "^3.3.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "discord-api-types": "^0.36.3",
    "discord.js": "^14.28.1",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "gifenc": "^1.0.3",
    "i18next": "^26.7.2",
    "jsqr": "^1.4.0",
    "katex": "0.18.2",
    "leaflet": "1.9.4",
    "music-metadata": "^12.7.0",
    "nodemailer": "10.5.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-i18next": "^17.1.13",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "three": "0.170.0",
    "uuid": "^14.0.3",
    "web-push": "3.6.7",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "serve": "^14.2.8",
    "unicode-emoji-json": "0.8.0",
    "vite": "^8.3.8"
  },
  "license": "Apache-2.0"
}
